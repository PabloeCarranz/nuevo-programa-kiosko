# Copiar a .env y completar. .env nunca se commitea.

# Ruta a la base SQLite. Se crea con scripts/crear_base_demo.py.
DB_PATH=../datos/negocio.db

# Secreto para firmar la cookie de sesion. Generar uno propio, no reusar este.
SESSION_SECRET=cambiar-este-valor-por-uno-aleatorio-largo

# Carpetas donde se guardan los comprobantes y reportes de cierre.
RECEIPTS_DIR=../datos/comprobantes
CIERRES_DIR=../datos/cierres

# SMTP para el envio de reportes de cierre de caja y diferencias de inventario.
# Usar una contrasena de aplicacion de Gmail del propio negocio.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_DESTINATARIO=

# Origen permitido para CORS (URL del frontend en desarrollo).
CORS_ORIGIN=http://localhost:5173
